{
  "name": "galung-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts playwright.config.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts playwright.config.ts *.mjs *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts playwright.config.ts *.mjs *.json *.yaml .github/workflows/*.yml",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "tsx scripts/run-tests.ts integration",
    "test:e2e": "tsx scripts/run-tests.ts e2e",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:status": "payload migrate:status",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "test:database": "tsx scripts/run-tests.ts database"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "graphql": "16.8.1",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": "3.4.17",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@lexical/headless>happy-dom": "21.0.4"
    },
    "patchedDependencies": {
      "@payloadcms/db-postgres@3.92.0": "patches/@payloadcms__db-postgres@3.92.0.patch"
    }
  }
}
