# Local development only. Copy to .env and replace both CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://galung:CHANGE_ME@127.0.0.1:5432/galung
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public indexing is disabled by default; sensitive routes always remain noindex.
# Optional dedicated test-cluster connection; tests create/drop only random databases.
# Defaults to DATABASE_URL only when its host is loopback. The test role needs CREATEDB.
# TEST_DATABASE_URL=postgresql://galung:CHANGE_ME@127.0.0.1:5432/postgres
# Operator-only temporary credentials for pnpm admin:create. Remove after creation.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Storage and Contact settings are below; monitoring configuration remains TBD.

# Enable only after production content, translations, legal and hosting approval.
PUBLIC_INDEXING=false

# Contact SMTP: fill from DomaiNesia Connect Devices; never put passwords in chat/source control.
# Enable only after SMTP credentials and retention worker have been verified.
CONTACT_ENABLED=false
CONTACT_SMTP_HOST=mx3.mailspace.id
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURITY=tls
CONTACT_SMTP_USER=admin@galung.id
CONTACT_SMTP_FROM=admin@galung.id
CONTACT_SMTP_PASSWORD=
# Optional protected retention endpoint; generate an independent random secret >=32 characters.
CONTACT_MAINTENANCE_SECRET=
# Optional only behind a proxy that strips/replaces this header; otherwise leave empty (shared limit).
CONTACT_TRUSTED_IP_HEADER=

# Private versioned installer bucket; independent from CMS media. Never NEXT_PUBLIC.
DOWNLOAD_S3_ENDPOINT=
DOWNLOAD_S3_BUCKET=
DOWNLOAD_S3_REGION=us-east-1
DOWNLOAD_S3_ACCESS_KEY=
DOWNLOAD_S3_SECRET_KEY=
# Explicit actual-build allowlist, comma-separated os:architecture. Empty disables uploads.
# OS values: windows,macos. Architecture identifiers must come from approved builds.
DOWNLOAD_ARCHITECTURES=
