# Local development only. Copy to .env and replace both CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://galung:CHANGE_ME@127.0.0.1:5432/galung
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# All routes remain noindex during the foundation phase.
# Optional dedicated test-cluster connection; tests create/drop only random databases.
# Defaults to DATABASE_URL only when its host is loopback. The test role needs CREATEDB.
# TEST_DATABASE_URL=postgresql://galung:CHANGE_ME@127.0.0.1:5432/postgres
# Operator-only temporary credentials for pnpm admin:create. Remove after creation.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Storage/contact/monitoring settings will be defined in their implementation phases.
